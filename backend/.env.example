# Environment settings: comments explain each key; existing values are preserved.
# TCP port used by the backend HTTP server; defaults to 5000 when unset.
PORT=5000
# MongoDB connection string used by the backend. Keep any embedded database credentials private.
MONGO_URI=mongodb://127.0.0.1:27017/autoserv
# Frontend URL used for the allowed request origin and links in emails; include the scheme and port when needed.
FRONTEND_URL=http://localhost:5173
# Set to production for secure session cookies and required TLS in SMTP helpers; otherwise use development locally.
NODE_ENV=development

# Password reset mail. Use your SMTP provider's settings.
# Mail server hostname. Password reset email requires this, MAIL_FROM, and FRONTEND_URL.
SMTP_HOST=
# SMTP port: 465 uses implicit TLS; the default is 587.
SMTP_PORT=587
# SMTP authentication username. Leave empty only when the mail server permits unauthenticated delivery.
SMTP_USER=
# Private SMTP authentication password or provider app password; never copy it into frontend settings.
SMTP_PASSWORD=
# Sender address used for outgoing mail, optionally including a display name.
MAIL_FROM=
